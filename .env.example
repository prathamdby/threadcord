# --- Database ---
# Postgres connection string. Docker Compose default points at the postgres service.
DATABASE_URL=postgres://threadcord:threadcord@postgres:5432/threadcord

# --- Discord ---
DISCORD_BOT_TOKEN=

# --- GitHub ---
# Token for clone, push, and pull request creation.
GITHUB_TOKEN=

# --- Workspace ---
# Local path for cloned repos and setup workspaces. Docker Compose uses /workspaces via a volume mount.
WORKSPACE_ROOT=./workspaces
# Days after terminal task completion before the task workspace directory is deleted (janitor runs periodically).
WORKSPACE_TTL_DAYS=14

# --- Task policy ---
# Max agent runs in parallel. Extra tasks queue until a slot opens.
MAX_CONCURRENT_TASKS=3
# Abort a coding/setup turn after this many consecutive tool errors (stops retry loops).
AGENT_MAX_TOOL_FAILURES=10
# Abort a coding/setup turn after this many consecutive validation/schema tool errors (stops error spirals early).
AGENT_MAX_VALIDATION_FAILURES=3

# --- AgentOS runtime ---
# Cap simultaneous AgentOS VMs on the host. The 4c/24GB target comfortably fits 2.
MAX_ACTIVE_VMS=2
# System/Postgres memory headroom in MB. Admission rejects turns when free memory
# falls below this value.
RESERVED_SYSTEM_MEMORY_MB=4096
# Minimum free disk in MB required to start a turn or promote a setup profile.
MIN_FREE_DISK_MB=2048
# Optional override for the AgentOS sidecar binary path. Auto-resolved from the
# @rivet-dev/agentos-sidecar package when unset.
AGENTOS_SIDECAR_BIN=
# Enable the self-hosted sandbox fallback for repos AgentOS cannot faithfully run.
AGENTOS_SANDBOX_ENABLE=false
# AgentOS runtime log level (debug, info, warn, error).
RUNTIME_LOG_LEVEL=info
# Per-turn wall-clock timeout in milliseconds (1 hour).
TURN_TIMEOUT_MS=3600000
# Heartbeat expiry in milliseconds (2 minutes). A turn whose heartbeat is older
# than this is marked interrupted on startup.
TURN_HEARTBEAT_TIMEOUT_MS=120000
# Per-setup/install command timeout in milliseconds (30 minutes).
SETUP_INSTALL_TIMEOUT_MS=1800000

# --- HTTP server ---
PORT=3583

# --- Built-in providers ---
# Set API key + comma-separated model IDs for each provider you want.
# At least one provider with models must be configured or the app fails at startup.
# Discord task messages use model: <provider>/<model-id> (optional; default is the first allowed model).
# Example: model: anthropic/claude-sonnet-4-5
ANTHROPIC_API_KEY=
# Comma-separated model IDs (without the anthropic/ prefix)
ANTHROPIC_MODELS=claude-sonnet-4-5

OPENAI_API_KEY=
# Comma-separated model IDs (without the openai/ prefix)
OPENAI_MODELS=gpt-5-codex

# --- Custom providers (non-catalog) ---
# List provider IDs here, then define each with PROVIDER_<ID>_* vars below.
# ID rules: lowercase letters, digits, hyphens only (e.g. ollama, my-gateway).
# Hyphens in the ID become underscores in env var names (my-gateway -> MY_GATEWAY).
PROVIDERS=ollama

# Provider: ollama
# Discord model field: ollama/<model-id from MODELS below>
PROVIDER_OLLAMA_BASE_URL=http://localhost:11434/v1
# Wire protocol. Common values: openai-completions, openai-responses, anthropic-messages
PROVIDER_OLLAMA_API=openai-completions
# Optional. Leave blank if the endpoint does not require auth.
PROVIDER_OLLAMA_API_KEY=
# Optional JSON object of extra headers sent with every provider request.
# Example for a provider ID agent-router:
# PROVIDER_AGENT_ROUTER_HEADERS={"User-Agent":"Threadcord"}
# Comma-separated model IDs (without the provider prefix)
PROVIDER_OLLAMA_MODELS=llama3.1:8b
