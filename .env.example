# =============================================================================
# Required — copy to .env and fill in values. App fails at startup if missing.
# =============================================================================

# Postgres (Compose: host "postgres"; local dev: localhost)
DATABASE_URL=postgres://threadcord:threadcord@postgres:5432/threadcord

# Discord bot token and the channel id where plain-text task messages are accepted.
# Optional: omit DISCORD_CHANNEL_ID to allow only /task create.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
GITHUB_TOKEN=

# At least one LLM provider (key + models must be set together). Tasks use
# model: <provider>/<model-id> in Discord; default is the first allowed model.
ANTHROPIC_API_KEY=
ANTHROPIC_MODELS=claude-sonnet-4-5

# =============================================================================
# Optional — defaults apply if unset. Uncomment and edit as needed.
# =============================================================================

# --- Workspace ---
# Clone and setup working directories. Default: /workspaces (Compose volume).
# Local dev without Docker:
# WORKSPACE_ROOT=./workspaces
#
# Delete task workspace dirs this many days after the task reaches a terminal
# status (completed/failed/cancelled). Janitor runs on an interval. Default: 14
# WORKSPACE_TTL_DAYS=14

# --- Task / agent policy ---
# Parallel agent turns (extra tasks queue). Default: 3
# MAX_CONCURRENT_TASKS=3
#
# pg-boss turn queue (durable jobs, retries, dead-letter)
# QUEUE_RETRY_LIMIT=3
# QUEUE_RETRY_DELAY_SECONDS=30
# QUEUE_RETRY_DELAY_MAX_SECONDS=300
# QUEUE_EXPIRE_IN_SECONDS=3600
# QUEUE_HEARTBEAT_SECONDS=60
# QUEUE_POLLING_INTERVAL_SECONDS=0.5
#
# Abort a turn after this many consecutive tool execution failures. Default: 10
# AGENT_MAX_TOOL_FAILURES=10
#
# Abort after consecutive tool argument/schema validation failures. Default: 3
# AGENT_MAX_VALIDATION_FAILURES=3
#
# Flue submission attempts per dispatched turn (run + recovery). Default: 2
# AGENT_SUBMISSION_MAX_ATTEMPTS=2

# --- HTTP server ---
# Hono listen port. Default: 3583
# PORT=3583
#
# Bearer for Flue HTTP routes (/agents/*, /workflows/*, /runs/*). Optional in
# dev; empty string is treated as unset. Required when NODE_ENV=production.
# THREADCORD_HTTP_BEARER=threadcord-dev-bearer

# --- Built-in OpenAI (Flue catalog) ---
# Optional second provider. KEY and MODELS must both be set or both omitted.
# OPENAI_API_KEY=
# OPENAI_MODELS=gpt-5-codex

# --- Custom providers (non-catalog: Ollama, gateways, proxies) ---
# Comma-separated provider IDs: lowercase letters, digits, hyphens only.
# Env vars use PROVIDER_<ID>_* with hyphens → underscores (my-gw → MY_GW).
# Discord: model: <id>/<entry-from-MODELS>
#
# PROVIDERS=ollama
#
# PROVIDER_OLLAMA_BASE_URL=http://localhost:11434/v1
# PROVIDER_OLLAMA_API=openai-completions
# PROVIDER_OLLAMA_MODELS=llama3.1:8b
# PROVIDER_OLLAMA_API_KEY=
#
# Optional JSON object of extra request headers (string values only):
# PROVIDER_AGENT_ROUTER_HEADERS={"User-Agent":"Threadcord"}
#
# Common PROVIDER_*_API values: openai-completions, openai-responses,
# anthropic-messages. See Flue provider API docs for the full list.
#
# Catalog providers can be proxied: list the ID in PROVIDERS and set
# PROVIDER_<ID>_BASE_URL (and API/MODELS as needed).
#
# In Docker, localhost in a provider URL is the container — use host.docker.internal,
# a Compose service name, or host networking to reach the host or another service.